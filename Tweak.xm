#import <UIKit/UIKit.h>
#import <Foundation/Foundation.h>
static UIWindow *gLabWindow=nil;
static NSString *const kLog=@"/var/mobile/TestTaLab.txt";
static void Log(NSString*s){NSString*x=[NSString stringWithFormat:@"[TESTTA-1.0] %@\n",s];NSFileHandle*h=[NSFileHandle fileHandleForWritingAtPath:kLog];if(!h)[x writeToFile:kLog atomically:YES encoding:NSUTF8StringEncoding error:nil];else @try{[h seekToEndOfFile];[h writeData:[x dataUsingEncoding:NSUTF8StringEncoding]];[h closeFile];}@catch(__unused NSException*e){}}
static UIWindowScene* CPScene(void){for(UIScene*r in UIApplication.sharedApplication.connectedScenes){if(![r isKindOfClass:UIWindowScene.class])continue;UIWindowScene*s=(UIWindowScene*)r;if([s.session.role localizedCaseInsensitiveContainsString:@"CarPlay"])return s;}return nil;}
static void MakeLab(void){UIWindowScene*s=CPScene();if(!s){Log(@"NO CARPLAY SCENE");return;}gLabWindow=[[UIWindow alloc]initWithWindowScene:s];gLabWindow.frame=s.screen.bounds;gLabWindow.windowLevel=2500;UIViewController*v=[UIViewController new];v.view.backgroundColor=UIColor.clearColor;gLabWindow.rootViewController=v;UIView*b=[[UIView alloc]initWithFrame:CGRectMake(8,8,88,88)];b.backgroundColor=UIColor.systemYellowColor;b.layer.cornerRadius=44;b.layer.borderWidth=7;b.layer.borderColor=UIColor.systemGreenColor.CGColor;b.userInteractionEnabled=NO;UILabel*l=[[UILabel alloc]initWithFrame:b.bounds];l.text=@"LAB";l.textAlignment=NSTextAlignmentCenter;l.font=[UIFont boldSystemFontOfSize:20];l.textColor=UIColor.blackColor;[b addSubview:l];[v.view addSubview:b];gLabWindow.hidden=NO;Log([NSString stringWithFormat:@"CREATED size=%@ level=%.0f",NSStringFromCGSize(s.screen.bounds.size),gLabWindow.windowLevel]);}
%ctor{@autoreleasepool{if(![NSBundle.mainBundle.bundleIdentifier isEqualToString:@"com.apple.CarPlayApp"])return;Log(@"ACTIVE");dispatch_after(dispatch_time(DISPATCH_TIME_NOW,2*NSEC_PER_SEC),dispatch_get_main_queue(),^{MakeLab();});}}
